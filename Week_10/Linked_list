// 		t1.next = new Node(20);
	
	
// Memory Representation:

// 	  t1 ──> [10 | address] ──> [20 | null]





// Creating Another Reference

// 	Node t2 = t1.next;
	
// 		○ t2 points to second node 

// Accessing Data

// 	System.out.println(t2.data);        // 20
// 	System.out.println(t1.next.data);   // 20
	
// 		○ Both give same result because both point to same node 

// Adding Next Node


// 	t2.next = new Node(30);
