
// Classes & Objects 


// 1. Class 

// 	A class is a blueprint to create objects.
	
// 	class Node {
// 	    int x = 0;
// 	    int y = 0;
// 	}
// 		○ x and y are data members (variables) of the class. 
// 		○ Default values: 0 



// 2. Object Creation


// 	Node n1 = new Node();
	
	
// 		○ n1 is a reference variable 
// 		○ new Node() creates an object in memory 

// 3. Accessing & Modifying Data

// 	n1.x = 10;
	
// 	n1.y = 20;
	
	
	
// 		○ Access using dot operator (.) 
// 		○ Changes values inside the object 

// 4. Reference Assignment 


// 	Node n2 = n1;
	
// 		○ n2 is NOT a new object 
// 		○ Both n1 and n2 point to same object 
		
// 	Effect:
	
// 		n2.x = 100;
		
// 		Now:
		
// 			§ n1.x = 100 
// 			§ n2.x = 100 
			
// 		Because both refer to same memory


// 5. Another Reference

// 	Node n3 = n1;
	
	
// 		○ Again, no new object created 
// 		○ n1, n2, n3 → same object 


// 6. Creating a New Object
	
// 	Node n4 = new Node();
	
// 		○ New separate object created 


// 7. Changing Reference


// 	n3 = n4;
	
// 	Now:
	
// 		○ n3 points to new object (n4) 
		
// 		○ n1 and n2 still point to old object 
	
	




